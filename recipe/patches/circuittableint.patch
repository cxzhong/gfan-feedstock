+// On macOS, long int and long long int are distinct C++ types (both 64-bit),
+// but __int64_t aliases long long. extMul(int,int) returns long int, making
+// toStr calls ambiguous. Add explicit overloads for long/unsigned long.
+#ifdef __APPLE__
+static std::string toStr(long int b)
+{
+	std::stringstream s;
+	s<<b;
+	return s.str();
+}
+
+static std::string toStr(unsigned long int b)
+{
+	std::stringstream s;
+	s<<b;
+	return s.str();
+}
+#endif
